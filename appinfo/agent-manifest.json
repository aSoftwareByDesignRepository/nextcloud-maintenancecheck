      "method": "POST",
      "path": "/mobile/v1/meters/{id}/readings",
      "idempotency": "clientRequestId",
      "scope": "maintenancecheck:meters:write",
      "label": "Add meter reading",
      "description": "Record a meter reading.",
      "params": {
        "id": {
          "type": "integer",
          "required": true,
          "description": "Path parameter (meter id)."
        },
        "value": {
          "type": "number",
          "required": true
        },
        "note": {
          "type": "string",
          "required": false
        },
        "idempotencyKey": {
          "type": "string",
          "required": false,
          "description": "Companion outbox key — safe replay."
        }
      }
    },
    {
      "name": "mn_add_work_order_comment",
      "kind": "write",
