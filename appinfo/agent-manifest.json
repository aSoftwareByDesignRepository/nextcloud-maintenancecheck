    {
      "name": "mn_complete_visit",
      "kind": "write",
      "riskClass": 2,
      "confirm": "required",
      "route": "mobile#complete",
      "method": "POST",
      "path": "/mobile/v1/visits/{id}/complete",
      "idempotency": "natural",
      "scope": "maintenancecheck:visits:write",
      "label": "Complete visit",
      "description": "Mark a visit complete (state transition — confirm required).",
      "params": {
        "id": {
          "type": "integer",
          "required": true,
          "description": "Path parameter."
        },
        "notes": {
          "type": "string",
          "required": false
        },
        "closingReading": {
          "type": "number",
          "required": false,
          "description": "Closing meter reading."
        }
      }
    },
    {
      "name": "mn_skip_visit",
      "kind": "write",
      "riskClass": 2,
      "confirm": "required",
      "route": "mobile#skip",
      "method": "POST",
      "path": "/mobile/v1/visits/{id}/skip",
      "idempotency": "natural",
      "scope": "maintenancecheck:visits:write",
      "label": "Skip visit",
      "description": "Skip a visit with a reason (state transition — confirm required).",
      "params": {
        "id": {
          "type": "integer",
          "required": true,
          "description": "Path parameter."
        },
        "reason": {
          "type": "string",
          "required": false
        }
      }
    },
    {
      "name": "mn_open_work_order",
      "kind": "write",
      "riskClass": 1,
      "route": "mobile#createWorkOrderFromVisit",
      "method": "POST",
      "path": "/mobile/v1/visits/{visitId}/work-orders",
      "idempotency": "natural",
      "scope": "maintenancecheck:work_orders:write",
      "label": "Open work order",
      "description": "Create or reopen the inspection work order for a visit (idempotent by design).",
      "params": {
        "visitId": {
          "type": "integer",
          "required": true,
          "description": "Path parameter."
        },
        "procedureId": {
          "type": "integer",
          "required": false
        },
        "obligationId": {
          "type": "integer",
          "required": false
        },
        "primaryUserId": {
          "type": "string",
          "required": false
        },
        "helperUids": {
          "type": "array",
          "required": false
        },
        "estimatedMinutes": {
          "type": "integer",
          "required": false
        }
      }
    },
    {
      "name": "mn_transition_work_order",
      "kind": "write",
      "riskClass": 2,
      "confirm": "required",
      "route": "mobile#workOrderTransition",
      "method": "POST",
      "path": "/mobile/v1/work-orders/{id}/transition",
      "idempotency": "natural",
      "scope": "maintenancecheck:work_orders:write",
      "label": "Transition work order",
      "description": "Move a work order along its status workflow (state transition — confirm required).",
      "params": {
        "id": {
          "type": "integer",
          "required": true,
          "description": "Path parameter."
        },
        "status": {
          "type": "string",
          "required": true
        },
        "closingReading": {
          "type": "number",
          "required": false
        },
        "laborMinutes": {
          "type": "integer",
          "required": false
        },
        "procedureSkipped": {
          "type": "boolean",
          "required": false
        },
        "procedureSkipReason": {
          "type": "string",
          "required": false
        },
        "notes": {
          "type": "string",
          "required": false
        }
      }
    },
