# Copy to tests/e2e/.env (gitignored) and fill in local-only passwords.
# Never commit real credentials.
NC_BASE_URL=http://localhost:8081

# NC_E2E_* — any L2-allowed user (due board, customers).
NC_E2E_USER=mn_e2e
NC_E2E_PASS=

# NC_ADMIN_* — NC admin or app admin (settings sections).
NC_ADMIN_USER=admin
NC_ADMIN_PASS=

# Optional: technician account for UJ-1 Alt B (created separately on the instance).
NC_TECH_USER=mn_e2e_tech
NC_TECH_PASS=
